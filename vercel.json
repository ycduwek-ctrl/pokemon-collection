{
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-db.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-auth.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-identity.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-fantasy.css",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-fantasy.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-energy-symbols.png",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-icon-02.svg",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-icon-193.png",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-icon-513.png",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-camera.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-camera.css",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-scan-strategy.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-set-vision.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-sets.js",
      "use": "@vercel/static"
    },
    {
      "src": "hitim-sets.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(?:index\\.html)?$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Hitim-Build": "hitim-set-library-v20.0"
      },
      "continue": true
    },
    {
      "src": "^/(?:sw\\.js|hitim-auth\\.js)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/hitim-set-vision.js",
      "dest": "/hitim-set-vision.js"
    },
    {
      "src": "/hitim-sets.js",
      "dest": "/hitim-sets.js"
    },
    {
      "src": "/hitim-sets.css",
      "dest": "/hitim-sets.css"
    },
    {
      "src": "/hitim-camera.js",
      "dest": "/hitim-camera.js"
    },
    {
      "src": "/hitim-camera.css",
      "dest": "/hitim-camera.css"
    },
    {
      "src": "/hitim-scan-strategy.js",
      "dest": "/hitim-scan-strategy.js"
    },
    {
      "src": "/hitim-identity.js",
      "dest": "/hitim-identity.js"
    },
    {
      "src": "/hitim-db.js",
      "dest": "/hitim-db.js"
    },
    {
      "src": "/hitim-auth.js",
      "dest": "/hitim-auth.js"
    },
    {
      "src": "/hitim-fantasy.css",
      "dest": "/hitim-fantasy.css"
    },
    {
      "src": "/hitim-fantasy.js",
      "dest": "/hitim-fantasy.js"
    },
    {
      "src": "/hitim-energy-symbols.png",
      "dest": "/hitim-energy-symbols.png"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/hitim-icon-02.svg",
      "dest": "/hitim-icon-02.svg"
    },
    {
      "src": "/hitim-icon-193.png",
      "dest": "/hitim-icon-193.png"
    },
    {
      "src": "/hitim-icon-513.png",
      "dest": "/hitim-icon-513.png"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
